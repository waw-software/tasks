{
	"name": "@waw/core-worker",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/runtime.d.ts",
			"default": "./dist/runtime.js"
		}
	},
	"scripts": {
		"build": "tsc -p tsconfig.build.json",
		"start": "node dist/index.js",
		"dev": "tsc -p tsconfig.build.json && node --watch dist/index.js",
		"typecheck": "tsc --noEmit -p tsconfig.json",
		"test": "vitest run"
	},
	"dependencies": {
		"pg-boss": "^12.39.0"
	},
	"devDependencies": {
		"@types/node": "^24.19.2",
		"vitest": "^5.1.1"
	}
}
